<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DisableWinUIXamlCompilerTask>true</DisableWinUIXamlCompilerTask>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Remove="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MahmoudAI.Core\MahmoudAI.Core.csproj" />
    <ProjectReference Include="..\MahmoudAI.WindowsIntegration\MahmoudAI.WindowsIntegration.csproj" />
    <ProjectReference Include="..\MahmoudAI.Storage\MahmoudAI.Storage.csproj" />
    <ProjectReference Include="..\MahmoudAI.Security\MahmoudAI.Security.csproj" />
    <ProjectReference Include="..\MahmoudAI.Mcp\MahmoudAI.Mcp.csproj" />
  </ItemGroup>

</Project>
