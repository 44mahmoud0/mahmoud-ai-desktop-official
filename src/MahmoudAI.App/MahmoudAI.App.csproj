<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DisableWinUIXamlCompilerTask>true</DisableWinUIXamlCompilerTask>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="MahmoudAI.WindowsIntegration.Automation" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MahmoudAI.Core\MahmoudAI.Core.csproj" />
    <ProjectReference Include="..\MahmoudAI.WindowsIntegration\MahmoudAI.WindowsIntegration.csproj" />
    <ProjectReference Include="..\MahmoudAI.Storage\MahmoudAI.Storage.csproj" />
    <ProjectReference Include="..\MahmoudAI.Security\MahmoudAI.Security.csproj" />
    <ProjectReference Include="..\MahmoudAI.Mcp\MahmoudAI.Mcp.csproj" />
  </ItemGroup>

</Project>
