<Project>
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>

    <!-- Scoped strictly to explicit unpackaged CI / CLI build mode via MahmoudAIUnpackagedCiBuild=true -->
    <WindowsPackageType Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">false</EnableMsixTooling>
    <AppxPackage Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">false</AppxPackage>
    <GenerateAppxPackageOnBuild Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">false</GenerateAppxPackageOnBuild>
    <AppxGeneratePriEnabled Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">false</AppxGeneratePriEnabled>
    <EnableCoreMrtTooling Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">false</EnableCoreMrtTooling>
    <EnablePriGenTooling Condition="'$(MahmoudAIUnpackagedCiBuild)' == 'true'">false</EnablePriGenTooling>
  </PropertyGroup>
</Project>
